{
  "name": "geotwin-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @geotwin/api\" \"npm run dev -w @geotwin/web\"",
    "build": "npm run build -w @geotwin/shared && npm run build -w @geotwin/api && npm run build -w @geotwin/web",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "npm run db:test && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx apps/api/src/db/cli.ts migrate",
    "db:seed": "tsx apps/api/src/db/cli.ts seed",
    "db:test": "tsx apps/api/src/db/cli.ts test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "predev": "npm run build -w @geotwin/shared",
    "pretest": "npm run build -w @geotwin/shared",
    "pretest:integration": "npm run build -w @geotwin/shared"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "dotenv": "^17.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.3"
  }
}

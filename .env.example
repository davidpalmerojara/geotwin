# Local demo only. Set your own credentials for any non-local environment.
POSTGRES_USER=geotwin
POSTGRES_PASSWORD=geotwin_local
POSTGRES_DB=geotwin
DATABASE_URL=postgresql://geotwin:geotwin_local@localhost:55432/geotwin
TEST_DATABASE_URL=postgresql://geotwin:geotwin_local@localhost:55432/geotwin_test
PORT=3001
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE=true
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=5000
READINGS_RETENTION_HOURS=24
VITE_CESIUM_ION_TOKEN=
# Object storage. local: a folder (development, tests); s3: AWS S3 or MinIO.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=data/storage
# With STORAGE_DRIVER=s3 (Docker Compose sets these for its MinIO service):
# S3_BUCKET=geotwin
# S3_REGION=eu-south-2
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_CREATE_BUCKET=false
# Local MinIO credentials used by docker-compose.yml. Change them for anything not local.
MINIO_ROOT_USER=geotwin
MINIO_ROOT_PASSWORD=geotwin_local_minio
# Largest LAS/LAZ upload in bytes (150 MiB: a 1 x 1 km PNOA tile is 40-70 MB).
LAYER_UPLOAD_MAX_BYTES=157286400
# Worker: Python with apps/worker/python/requirements.txt installed (a venv path is fine).
LIDAR_PYTHON=python3
WORKER_CONCURRENCY=1
LAYER_JOB_TIMEOUT_SECONDS=1800
LAYER_JOB_RETRY_LIMIT=2
# Optional folder with es_ign_egm08-rednap.tif (official geoid). Without it: EGM96 at tile centre.
GEOID_GRID_DIR=
# Optional fixed geoid undulation in metres for every layer (overrides both models).
GEOID_OFFSET_M=
